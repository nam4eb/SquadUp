APP_KEY=base64:replace-with-php-artisan-key-generate-show
APP_URL=https://api.example.com
API_PORT=8000
API_RATE_LIMIT_PER_MINUTE=120
REQUEST_LOG_SAMPLE_RATE=0.05
SLOW_REQUEST_MS=500

# Tune these values to the memory available on the API host. The defaults below
# need roughly 1.5-2 GB at full PHP-FPM concurrency for this application.
PHP_FPM_PM_CONTROL=dynamic
PHP_FPM_PM_MAX_CHILDREN=40
PHP_FPM_PM_START_SERVERS=8
PHP_FPM_PM_MIN_SPARE_SERVERS=8
PHP_FPM_PM_MAX_SPARE_SERVERS=20
PHP_FPM_PM_MAX_REQUESTS=500

POSTGRES_DB=squadup
POSTGRES_USER=squadup
POSTGRES_PASSWORD=replace-with-a-strong-password

REDIS_PASSWORD=replace-with-a-strong-password

REVERB_APP_ID=squadup-production
REVERB_APP_KEY=replace-with-a-random-key
REVERB_APP_SECRET=replace-with-a-random-secret
REVERB_PORT=8080

LOG_LEVEL=warning
SQUADUP_IMAGE=squadup-api-production:latest
SQUADUP_OCTANE_IMAGE=squadup-api-octane:latest
OCTANE_WORKERS=8
OCTANE_MAX_REQUESTS=500
